{
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.activeIconPack": "nest",
  "material-icon-theme.files.associations": {
    "*.repository.ts": "nest-guard",
    "*.module.ts": "nest-module",
    "*.controller.ts": "nest-controller",
    "*.service.ts": "nest-service",
    "*.guard.ts": "nest-guard",
    "*.interceptor.ts": "nest-interceptor",
    "*.pipe.ts": "nest-pipe",
    "*.dto.ts": "nest-service",
    "*.interface.ts": "nest-service",
    "*.query.ts": "nest-gateway",
    "*.handler.ts": "nest-module",
    "*.command.ts": "nest-controller",
    "*.entity.ts": "nest-gateway",
    "*.schema.ts": "nest-gateway",
    "*.provider.ts": "nest-pipe",
    "*.enum.ts": "nest-interceptor",
  },
  "material-icon-theme.folders.associations": {
    "dtos": "custom",
    "queries": "log",
    "typeorm": "database",
    "domain": "class",
    "webhooks": "hook",
    "features": "",
    "policies": "",
    "media": "",
    "email": "",
    "contracts": "",
    "clients": "",
    "properties": "",
    "tickets": "",
  },
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "claudeCode.preferredLocation": "panel",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "workbench.colorTheme": "Bearded Theme Monokai Black",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "[json]": {
    "editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
  },
  "sonarlint.focusOnNewCode": true,
  "sonarlint.automaticAnalysis": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.gpuAcceleration": "off",
  "atlascode.rovodev.showEntitlementNotifications": false,
  "atlascode.bitbucket.pipelines.monitorEnabled": false,
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "task.allowAutomaticTasks": "on",
}
